# モデル anima-llm の定義（FROM 行は起動時に entrypoint が GGUF の場所から付け足す）
#
# ここに書くのは Llama 3 のチャット形式（特殊トークンの並べ方）だけ。
# - 人格・口調・既定の system 指示は書かない
# - Ollama 公式テンプレートが入れる定型文（知識の期限・今日の日付など）も入れない
# - sampling（seed・temperature など）は実行環境の設定（config/environment/）から毎回渡す

TEMPLATE """<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>
{{- range .Messages }}
{{- if eq .Role "user" }}<|start_header_id|>user<|end_header_id|>

{{ .Content }}<|eot_id|>
{{- else if eq .Role "assistant" }}<|start_header_id|>assistant<|end_header_id|>

{{ .Content }}<|eot_id|>
{{- end }}
{{- end }}<|start_header_id|>assistant<|end_header_id|>

"""

PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
